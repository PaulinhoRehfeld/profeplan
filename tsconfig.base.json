{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["dom", "dom.iterable", "es2024"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@profeplan/types": ["packages/types/src"],
      "@profeplan/ui": ["packages/ui/src"],
      "@profeplan/auth": ["packages/auth/src"],
      "@profeplan/config": ["packages/config/src"],
      "@profeplan/logger": ["packages/logger/src"],
      "@profeplan/db": ["packages/db/src"],
      "@profeplan/ai": ["packages/ai/src"]
    }
  }
}
