{
    "name": "profeplan-monorepo",
    "version": "4.0.0",
    "private": true,
    "description": "Profeplan - Industrial Monorepo Architecture",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=apps/web",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test --workspaces --if-present"
    },
    "engines": {
        "node": "22.x",
        "npm": ">=10.0.0"
    },
    "devDependencies": {
        "@vercel/node": "^5.6.10"
    }
}
