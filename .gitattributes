* text=auto

# Force LF for Android/Gradle files to avoid Windows CRLF warnings and build issues
*.gradle text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Force LF for web source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
