# ═══════════════════════════════════════════════════════════
#  PROFEPLAN — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o .env com valores reais.
# ═══════════════════════════════════════════════════════════

# ── Supabase (Frontend — prefixo VITE_ é exposto ao browser) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ── Supabase (Backend / Vercel Serverless — NUNCA expor ao frontend) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=                                  # ⚠️ SECRET — preferida
# Compatibilidade temporária para rollback. Não use em novos ambientes.
SUPABASE_SERVICE_ROLE_KEY=                            # ⚠️ SECRET — legado

# ── URL da aplicação ──
# Usado nos links de e-mail e CORS das funções serverless
APP_URL=https://profeplan.vercel.app

# ── E-mail / Resend ──
# Crie sua conta em resend.com → API Keys → Create API Key
# Siga o guia completo em docs/EMAIL_SETUP.md
RESEND_API_KEY=re_your_resend_api_key_here           # ⚠️ SECRET
SMTP_FROM_EMAIL=noreply@profeplan.com.br
SMTP_FROM_NAME=PROFEPLAN

# ── IA ──
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here       # ⚠️ SECRET
DEEPSEEK_API_BASE=https://api.deepseek.com
GEMINI_API_KEY=                                      # ⚠️ SECRET — embeddings server-side

# ── Stripe ──
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_key_here
