{
    "framework": "vite",
    "buildCommand": "npx vite build",
    "outputDirectory": "dist",
    "regions": [
        "gru1"
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}