{
    "version": 2,
    "framework": "vite",
    "buildCommand": "npm run build --workspace=apps/web",
    "outputDirectory": "apps/web/dist",
    "installCommand": "rm -f package-lock.json apps/web/package-lock.json && npm install --include=optional",
    "regions": [
        "gru1"
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}