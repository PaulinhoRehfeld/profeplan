{
    "version": 2,
    "framework": "vite",
    "buildCommand": "npm run build --workspace=apps/web",
    "outputDirectory": "apps/web/dist",
    "installCommand": "npm install",
    "regions": [
        "gru1"
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}